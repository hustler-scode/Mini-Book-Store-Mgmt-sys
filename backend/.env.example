PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minibookstore
DB_USER=postgres
DB_PASSWORD=postgres
# Or complete connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minibookstore

# Note: For zero-setup instant local demo or offline testing without active PostgreSQL server:
# DB_DIALECT=sqlite

# JWT Configuration
JWT_SECRET=mini-bookstore-jwt-secret-key-2026-development
JWT_EXPIRES_IN=7d

